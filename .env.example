# Copia este archivo a ".env" (en la raíz del proyecto) y completa los valores.
# NUNCA subas ".env" a GitHub (ya está en .gitignore).

# ---------- Base vectorial (ACA 1) ----------
# Supabase > botón "Connect" > Connection string > "Session pooler" (IPv4, puerto 5432)
# Formato: postgresql://postgres.<project-ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# ---------- Embeddings locales (los mismos con los que se indexó en el ACA 1) ----------
OLLAMA_HOST=http://localhost:11434
EMBED_MODEL=embeddinggemma-2
EMBED_DIM=768

# ---------- LLM en la nube (ACA 2) ----------
# Clave gratuita en https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---------- Hiperparámetros por defecto (opcionales; se ajustan en la barra lateral) ----------
TOP_K=5
SIM_THRESHOLD=0.70
TEMPERATURE=0.2
