# Copia este archivo a ".env" (en la raíz del proyecto) y completa los valores.
# NUNCA subas ".env" a GitHub (ya está en .gitignore).

# Supabase > botón "Connect" > Connection string > "Session pooler" (IPv4, puerto 5432)
# Formato: postgresql://postgres.<project-ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Ollama local (embeddings sin costo). Descarga el modelo una vez con: ollama pull embeddinggemma
OLLAMA_HOST=http://localhost:11434
EMBED_MODEL=embeddinggemma-2
EMBED_DIM=768
